# Streamlit Community Cloud secrets template.
#
# Do NOT commit a filled-in copy of this file. Locally the app reads a
# git-ignored `.env` instead; this file is only for deployment.
#
# To deploy:
#   1. share.streamlit.io -> New app -> pick this repo, branch `main`,
#      main file `app.py`
#   2. Advanced settings -> Secrets -> paste the lines below, filled in
#   3. Deploy
#
# Everything here is optional. With no key at all the app still runs and
# uses the deterministic offline generator.

# --- Google Gemini (free tier) ---------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-gemini-key"
LEADQUAL_PROVIDER = "gemini"
LEADQUAL_GEMINI_MODEL = "gemini-3.5-flash-lite"

# --- Anthropic Claude (paid) -----------------------------------------------
# ANTHROPIC_API_KEY = "sk-ant-..."
# LEADQUAL_PROVIDER = "anthropic"
# LEADQUAL_MODEL = "claude-haiku-5-5"

# --- Application -----------------------------------------------------------
LEADQUAL_MAX_TOKENS = "4000"
LEADQUAL_ALLOW_FALLBACK = "true"
