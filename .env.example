# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# "anthropic" (Claude) or "gemini" (Google).
# Leave this blank and the app picks whichever provider actually has a key:
# Anthropic first, then Gemini.
LEADQUAL_PROVIDER=

# ---------------------------------------------------------------------------
# Anthropic Claude  -  https://console.anthropic.com/
# Paid: no free tier, minimum top-up around $5.
# Cost of one full run over the 10 sample leads:
#   claude-haiku-5-5  ~$0.007   (the default - cheapest)
#   claude-sonnet-5-5 ~$0.13
#   claude-opus-5-5   ~$0.26    (most capable)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEADQUAL_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Google Gemini  -  https://aistudio.google.com/apikey
# Free tier, no credit card needed. Flash and Flash-Lite models are free of
# charge; Flash-Lite is the lightest and has the most generous free limits.
# Note: on the free tier Google may use the content to improve their products,
# so only the synthetic sample data in this project should be sent.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEADQUAL_GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Maximum tokens for the LLM response.
LEADQUAL_MAX_TOKENS=4000

# Path to the SQLite database file.
LEADQUAL_DB_PATH=data/leadqual.db

# When "true", never call the network - always use the deterministic
# offline generator. Useful for marking/demo without credits.
LEADQUAL_OFFLINE=false

# When "true", fall back to the offline generator if the API call fails.
# Set to "false" to prove a live call really happened: failures then raise
# instead of being silently absorbed.
LEADQUAL_ALLOW_FALLBACK=true
